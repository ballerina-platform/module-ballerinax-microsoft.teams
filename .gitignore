# Target folder of ballerina project (root and all sub-packages, e.g. examples/*)
/target
target/

# Build artifacts (jars / bir) - regenerated by `bal build`
*.jar
*.bir

# VS Code workspace/launch config
.vscode/

# Claude Code local settings
.claude/

# Auto-generated dependency lock files for example packages
# (ballerina/Dependencies.toml is intentionally tracked)
examples/*/Dependencies.toml

# resources folder
/resources

# idea files
*.idea

# .ballerina files
*.ballerina

# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build

#
*.log

# Local credentials for live testing/examples - never commit real secrets
Config.toml